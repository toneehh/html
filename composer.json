{
    "name": "toneehh/html",
    "description": "Fork of HTML and Form Builders for the Laravel 11.",
    "license": "MIT",
    "homepage": "https://github.com/toneehh/html",
    "support": {
        "issues": "https://github.com/toneehh/html/issues",
        "source": "https://github.com/toneehh/html"
    },
    "authors": [
        {
            "name": "Toni",
            "email": "tonipetrov6@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "illuminate/database": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "mockery/mockery": "~1.0",
        "phpunit/phpunit": "~8.5|^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Collective\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Collective\\Html\\FormFacade",
                "Html": "Collective\\Html\\HtmlFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
